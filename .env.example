# Public site URLs
VITE_SITE_URL=https://makranahomeart.com
PUBLIC_SITE_URL=https://makranahomeart.com
NEXT_PUBLIC_SITE_URL=https://makranahomeart.com
APP_URL=https://makranahomeart.com
SITE_URL=https://makranahomeart.com

# Server
HOST=0.0.0.0
PORT=10000

# App
VITE_APP_NAME=Makrana Home Art
VITE_APP_ENV=production
VITE_ENABLE_DEV_ADMIN=false

# Supabase public/frontend keys
# Keep these as public anon/publishable keys only. Do not use service role here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase server keys
# SUPABASE_SERVICE_ROLE_KEY is secret. Never prefix it with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local development only
VITE_DEV_ADMIN_EMAIL=
VITE_DEV_ADMIN_PASSWORD=
